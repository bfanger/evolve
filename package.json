{
  "name": "svelte-project-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node src/varlockSync.ts && concurrently -c \"#c596c7\",\"#676778\",\"#4b32c3\",\"#fafafa\" --kill-others-on-fail \"npm:lint:*\"",
    "lint:prettier": "prettier --check . \"src/**/*.{svelte,ts,scss,css,html}\"",
    "lint:svelte-check": "svelte-check --fail-on-warnings --tsgo --diagnostic-sources \"js,svelte\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:stylelint": "stylelint --max-warnings=0 \"src/**/*.{css,scss,svelte}\"",
    "format": "eslint --fix && stylelint --fix \"src/**/*.{css,scss,svelte}\" && prettier --write . \"src/**/*.{svelte,ts,scss,css,html}\"",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,svelte}": [
      "eslint --max-warnings 0 --no-ignore",
      "svelte-check --fail-on-warnings"
    ],
    "*.(c)?js": [
      "eslint --max-warnings 0 --no-ignore"
    ],
    "*.{css,scss,json,html}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@varlock/vite-integration": "^1.5.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-preset-env": "^11.5.5",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "6",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "pixi.js": "^8.21.0",
    "valibot": "^1.5.0",
    "varlock": "^1.21.1"
  }
}
